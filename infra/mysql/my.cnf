# LAIAI-NEXT MySQL 加固（移植旧平台 hardening）
[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
max_connections = 150
# 2G：2026-11-19 由 4G 在线缩容一半并固化——素材归档与账单清理后大表热工作集
# 明显缩小，4G 池远超全量数据所需（数据+索引 10.17GB），小内存机按热集预算；
# 观察 Innodb_buffer_pool_wait_free 与命中率，不足时在线调回（SET GLOBAL 即可）。
innodb_buffer_pool_size = 2G

# 安全加固
local_infile = 0
skip_symbolic_links = 1

# 慢查询
slow_query_log = 1
long_query_time = 2

[client]
default-character-set = utf8mb4
