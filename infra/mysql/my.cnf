# LAIAI-NEXT MySQL 加固（移植旧平台 hardening）
[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
max_connections = 300
# 4G：任务量上千/天后 400k+ 行大表工作集需要常驻内存（2026-11-04 由 512M 在线扩容并固化）
innodb_buffer_pool_size = 4G

# 安全加固
local_infile = 0
skip_symbolic_links = 1

# 慢查询
slow_query_log = 1
long_query_time = 2

[client]
default-character-set = utf8mb4
