# LAIAI-NEXT 入口。
# LAIAI_DOMAIN 未设置时退化为 :80 纯 HTTP（裸服务器首次验证用）；
# 设置真实域名后 Caddy 自动 ACME 签证书。
#
# 移植的两个 Caddy 陷阱纪律：
#  1. respond/file_server 必须包在 handle 块里（directive 顺序陷阱）
#  2. 若前面还有一层反代/CDN，必须配置 servers>trusted_proxies，否则 X-Forwarded-* 被覆写
#
# WS-3 多实例：core 用 docker compose --scale 起多副本（无 container_name）。Caddy 用
# 「动态 DNS upstream」(dynamic a) 跟随 Docker 内嵌 DNS 解析出的全部副本 IP 做轮询负载均衡；
# 每 5s 重解析，副本增减自动跟随。
# ⚠️ 动态 upstream 只支持「被动」健康检查（fail_duration/unhealthy_status），不支持主动 health_uri
#    （Caddy 限制，对抗评审命中点）——故用被动：连续 5xx/拨号失败的副本临时摘除一段时间。

# core 反代 snippet（被三个 handle 复用，避免重复 + 保证负载均衡策略一致）。
(core_proxy) {
	reverse_proxy {
		dynamic a {
			name core
			port 8080
			refresh 5s
		}
		lb_policy round_robin
		lb_try_duration 5s
		fail_duration 30s   # 被动健康：拨号失败/坏响应的副本摘除 30s
		unhealthy_status 5xx
	}
}

{$LAIAI_DOMAIN} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		# CSP（审查 L6）：token 存于 JS storage，CSP 是 XSS 的关键兜底。
		# Vite 产物无内联脚本；style 'unsafe-inline' 因 Tailwind 运行时注入需要。
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
		-Server
	}

	handle /healthz {
		import core_proxy
	}

	# 控制面 API（Console 用）
	handle /api/* {
		import core_proxy
	}

	# 数据面 relay（chat/embeddings/images/video——对外统一 API）
	handle /v1/* {
		import core_proxy
	}

	# Console SPA（产物烤在镜像内 /srv/console）
	handle {
		root * /srv/console
		# 哈希命名资源永久缓存；index.html 永不缓存（发版即生效）
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@index path / /index.html
		header @index Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
