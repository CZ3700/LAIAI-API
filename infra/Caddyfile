# LAIAI-NEXT 入口。
# LAIAI_DOMAIN 未设置时退化为 :80 纯 HTTP（裸服务器首次验证用）；
# 设置真实域名后 Caddy 自动 ACME 签证书。
#
# 移植的两个 Caddy 陷阱纪律：
#  1. respond/file_server 必须包在 handle 块里（directive 顺序陷阱）
#  2. 若前面还有一层反代/CDN，必须配置 servers>trusted_proxies，否则 X-Forwarded-* 被覆写
#
# ⚠️ CF/CN2 前置本 Caddy 时（P1-2 IP 信任链，详见 docs/生产runbook.md §1）：
#    取消下面全局块注释并按真实边缘网段填写。不配的后果：Caddy 把 CF 设置的 XFF 重写成
#    CF 边缘 IP → core 看到的"客户端 IP"全是 CF 节点，keyGate IP 白名单/限流/审计全体失真。
#    Cloudflare 网段清单：https://www.cloudflare.com/ips/ （官方变更需跟进）
# {
# 	servers {
# 		trusted_proxies static 173.245.48.0/20 103.21.244.0/22   # ← 换成完整真实边缘网段
# 	}
# }
#    Caddy 作为最外层边缘（默认拓扑）时保持注释——对来源 XFF 的默认重写本身就是防伪造。
#
# WS-3 多实例：core 用 docker compose --scale 起多副本（无 container_name）。Caddy 用
# 「动态 DNS upstream」(dynamic a) 跟随 Docker 内嵌 DNS 解析出的全部副本 IP 做轮询负载均衡；
# 每 5s 重解析，副本增减自动跟随。
# ⚠️ 动态 upstream 只支持「被动」健康检查（fail_duration/unhealthy_status），不支持主动 health_uri
#    （Caddy 限制，对抗评审命中点）——故用被动：连续 5xx/拨号失败的副本临时摘除一段时间。

# core 反代 snippet（被三个 handle 复用，避免重复 + 保证负载均衡策略一致）。
(core_proxy) {
	reverse_proxy {
		dynamic a {
			name core
			port 8080
			refresh 5s
		}
		lb_policy round_robin
		lb_try_duration 5s
		# 被动健康：只对「拨号失败/不可达」摘除副本 30s。
		# ⚠️ 绝不用 unhealthy_status 5xx：relay 把 5xx 当正常业务响应下发（无可用渠道 503 /
		#    上游不可达 502 / 配置错误 503，且各带 JSON 错误体）。若按 5xx 摘副本，单副本下任一业务 5xx
		#    都会把整个后端标记不健康 30s，并因 lb_try_duration 找不到健康副本而吞掉 relay 的 JSON 错误体、
		#    回成空体 503（体验场报 request failed(503) 即此）——既级联宕机又掩盖真实原因。
		fail_duration 30s
	}
}

{$LAIAI_DOMAIN} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		# CSP（审查 L6）：token 存于 JS storage，CSP 是 XSS 的关键兜底。
		# Vite 产物无内联脚本；style 'unsafe-inline' 因 Tailwind 运行时注入需要。
		# img-src 含 https:：体验场生图结果可能是上游 CDN 的 https 图片 URL（非 base64），需允许内联显示；
		# 图片是被动内容、不执行脚本，风险低。
		#
		# media-src（视频黑屏根因，实测控制台报错）：缺该指令时回落 default-src 'self'，于是
		#   ① <video src="https://…厂商对象存储/x.mp4"> 被拒（Refused to load … media-src）
		#   ② 代理取流生成的 blob: URL 同样被拒
		# 两条把「直连」「同源代理」两条播放路径一起掐死，只剩下载（window.open 属导航，不受此限）。
		# 故放行 blob:（本站自己生成的对象 URL）与 https:（厂商产物 CDN），与 img-src 同档——
		# 媒体同为被动内容、不执行脚本。
		#
		# connect-src 增 https:：产物取流转 blob 是修 Content-Type 的唯一客户端手段（对象存储签名 URL
		# 常返 application/octet-stream，浏览器拒播；海外部署又代理不到国内存储）。厂商产物域名由
		# 运营配置、不可预先枚举，故按协议放行。**代价诚实说明**：XSS 下可外泄数据的面从 img 信标
		# 扩到可读响应的 fetch——但本站 img-src 早已放行 https:（信标外泄本就存在），且 Vue 默认转义 +
		# 无内联脚本，权衡后接受；若将来收紧，应改为「产物一律经平台代理 + connect-src 收回 'self'」，
		# 前提是部署地与厂商存储网络可达（当前海外 VPS ↔ 国内 TOS 不可达，故做不到）。
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; media-src 'self' blob: data: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' https:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
		-Server
	}

	handle /healthz {
		import core_proxy
	}

	# 控制面 API（Console 用）
	handle /api/* {
		import core_proxy
	}

	# 数据面 relay（chat/embeddings/images/video——对外统一 API）
	handle /v1/* {
		import core_proxy
	}

	# Console SPA（产物烤在镜像内 /srv/console）
	handle {
		root * /srv/console
		# 哈希命名资源永久缓存；index.html 永不缓存（发版即生效）
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@index path / /index.html
		header @index Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
