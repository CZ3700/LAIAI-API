# LAIAI-NEXT 部署配置。
# 最省事：直接跑 ./deploy.sh —— 它会自动生成这份 .env（全套密钥）并起栈，无需手填。
# 手动填写：cp .env.example .env 后逐项填。纪律：.env 永不入 git（.gitignore 已拦）；服务器上 chmod 600

# 生成方式：openssl rand -base64 32
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=

# >= 32 字符；core 缺它拒绝启动（绝不静默生成）。轮换会使所有会话失效。
LAIAI_AUTH_SECRET=

# 管理 API 门禁（>= 32 字符）。留空 = /api/admin/* 整组禁用（404）
LAIAI_ADMIN_TOKEN=

# 渠道凭证信封加密密钥环。格式 "k1:<base64 的 32 字节>"，多 key 逗号分隔。
# 生成：openssl rand -base64 32 。轮换 = 追加新 key + 切 ACTIVE，旧密文仍可解。
# 留空 = 渠道管理与 /v1 转发禁用
LAIAI_DATA_KEYS=
LAIAI_DATA_KEY_ACTIVE=k1

# 域名（如 api.example.com）。留空 = :80 纯 HTTP（仅首次裸机验证用）
LAIAI_DOMAIN=

# Invocation Store 保留天数（设计 §6.1），0 = 关闭自动清理
LAIAI_INVOCATION_RETENTION_DAYS=30

# 可信反代（P1-2 生产边缘 IP 信任链，详见 docs/生产runbook.md §1）：
#   留空 = 私网段默认（compose 拓扑：core 仅经同网 Caddy 可达，直接可用）；
#   none = 不信任任何代理头（core 直接对公网时用）；
#   其余 = 逗号分隔 CIDR/IP。CF/CN2 前置 Caddy 时无需改这里——改 Caddyfile trusted_proxies。
# ClientIP 是 keyGate IP 白名单 / 认证限流 / 审计 IP 的共同口径，配错三者同时失真。
LAIAI_TRUSTED_PROXIES=

# 生产镜像 digest 锁定（P1-6）—— 仅在叠加 docker-compose.prod.yml 时必填。
# 杜绝可变 tag 静默漂移；无 fallback，未填即拒绝启动。
# 取 digest：docker image inspect mysql:8.4 --format '{{index .RepoDigests 0}}'
# 把下面占位符替换成上面命令输出的真实 mysql@sha256:... / redis@sha256:...（勿照抄占位符）
MYSQL_IMAGE=mysql:8.4@sha256:REPLACE_WITH_REAL_DIGEST
REDIS_IMAGE=redis:7-alpine@sha256:REPLACE_WITH_REAL_DIGEST

# 构建代理：中国网络环境用 https://goproxy.cn,direct
GOPROXY=https://proxy.golang.org,direct
# npm 镜像：中国网络环境用 https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org

# 邮件（SMTP，可选）—— 全空则验证码仅打日志，不真实发送。
# 配置后即可启用邮箱验证（admin 设置页打开开关），堵同邮箱薅羊毛。
LAIAI_SMTP_HOST=
LAIAI_SMTP_PORT=587
LAIAI_SMTP_USERNAME=
LAIAI_SMTP_PASSWORD=
LAIAI_SMTP_FROM=

# Official video runtime. Empty HMAC leaves the official gateway disabled.
LAIAI_VIDEO_HMAC_SECRET=
LAIAI_VIDEO_ARTIFACT_ROOT=
LAIAI_VIDEO_ARTIFACT_TEMP=
LAIAI_VIDEO_ARTIFACT_HOSTS=
LAIAI_VIDEO_PORTRAIT_CALLBACK_URL=
# 认证完成后的已登记 HTTPS 后台页面；不能使用上面的官方回调接收入口。
LAIAI_VIDEO_PORTRAIT_RETURN_URL=

# Optional private media uploads: configure all fields together. Public URL must
# be HTTPS with the fixed /api/video/media-source path. Secrets stay server-side.
LAIAI_VIDEO_MEDIA_ROOT=
LAIAI_VIDEO_MEDIA_PUBLIC_BASE_URL=
LAIAI_VIDEO_MEDIA_SIGNING_KEY=
LAIAI_VIDEO_MEDIA_FFPROBE_PATH=
# JSON argv; an installed scanner receives the file path as its last argument.
LAIAI_VIDEO_MEDIA_SCAN_COMMAND=
